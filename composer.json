{
  "name": "boundstate/eventful",
  "version": "1.2.0",
  "type": "craft-plugin",
  "license": "proprietary",
  "authors": [
    {
      "name": "Bound State Software",
      "homepage": "https://boundstatesoftware.com"
    }
  ],
  "require": {
    "ext-zip": "*",
    "php": ">=8.2",
    "craftcms/cms": "^5.10.0",
    "sabre/vobject": "^4.5",
    "simshaun/recurr": "^5.0"
  },
  "require-dev": {
    "craftcms/commerce": "^5",
    "craftcms/generator": "^2",
    "craftcms/phpstan": "dev-main",
    "laravel/pint": "^1",
    "phpdocumentor/shim": "^3",
    "phpstan/phpstan": "^2",
    "rector/rector": "^2",
    "vlucas/phpdotenv": "^5",
    "yiisoft/yii2-shell": "^2"
  },
  "autoload": {
    "psr-4": {
      "boundstate\\eventful\\": "src/"
    }
  },
  "extra": {
    "handle": "eventful",
    "name": "Eventful",
    "developer": "Bound State Software",
    "documentationUrl": "https://eventful.boundstate.co",
    "class": "boundstate\\eventful\\Eventful"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "phpdocumentor/shim": true,
      "yiisoft/yii2-composer": true
    }
  },
  "scripts": {
    "phpdoc": "rm -Rf docs/reference && vendor/bin/phpdoc && mv docs/api/boundstate/eventful docs/reference && rm -Rf docs/api && npx prettier --write docs/reference --log-level warn",
    "phpstan": "phpstan --memory-limit=1G",
    "rector": "vendor/bin/rector"
  }
}
