<?xml version="1.0" encoding="UTF-8" ?>
<phpdocumentor
  configVersion="3"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="https://www.phpdoc.org"
>
    <paths>
        <output>docs/api</output>
    </paths>
    <template name=".phpdoc/template" />
    <version number="latest">
        <api>
            <source dsn=".">
                <path>src</path>
            </source>
            <visibility>public</visibility>
            <ignore>
                <path>src/Eventful.php</path>
                <path>src/controllers/**/*</path>
                <path>src/db/Table.php</path>
                <path>src/migrations/**/*</path>
                <path>src/records/**/*</path>
                <path>src/transformers/*</path>
                <path>src/translators/*</path>
                <path>src/web/**/*</path>
            </ignore>
        </api>
    </version>
</phpdocumentor>
