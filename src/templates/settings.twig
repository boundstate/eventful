{% import '_includes/forms.twig' as forms %}

{% set readOnly = not craft.app.config.general.allowAdminChanges %}

{{ forms.textField({
  first: true,
  label: 'Title Format'|t('app'),
  instructions: 'Displayed on calendar and used as ICS file summary.',
  name: 'eventTitleTemplate',
  value: settings.eventTitleTemplate,
  errors: settings.getErrors('eventTitleTemplate'),
  class: 'code',
  disabled: readOnly,
}) }}

{{ forms.textareaField({
  label: 'Description Format'|t('app'),
  instructions: 'Displayed on calendar and used as ICS file description.',
  name: 'eventDescriptionTemplate',
  value: settings.eventDescriptionTemplate,
  errors: settings.getErrors('eventDescriptionTemplate'),
  rows: 6,
  class: 'code',
  disabled: readOnly,
}) }}

{{ forms.textField({
  label: 'Location Format'|t('app'),
  instructions: 'Displayed on calendar and used as ICS file location.',
  name: 'eventLocationTemplate',
  value: settings.eventLocationTemplate,
  errors: settings.getErrors('eventLocationTemplate'),
  class: 'code',
  disabled: readOnly,
}) }}

<hr/>

{{ forms.lightswitchField({
  first: true,
  label: 'Always display time zones',
  instructions: 'Whether to display the time zones of event times in the calendar, and by default when using Twig filters. Otherwise, the calendar only displays an event’s time zone when it differs from the user’s.',
  name: 'displayTimezone',
  on: settings.displayTimezone,
  disabled: readOnly,
}) }}

<hr/>

<h2>{{ 'Calendar'|t('app') }}</h2>

{{ forms.autosuggestField({
  label: 'iCalendar Secret'|t('app'),
  instructions: 'Secret used in public iCalendar URL (leave empty for no public URL).'|t('app'),
  name: 'calendarSecret',
  value: settings.calendarSecret,
  errors: settings.getErrors('calendarSecret'),
  suggestEnvVars: true,
  disabled: readOnly,
}) }}

{{ forms.editableTableField({
  label: 'Extra Event Sources'|t('app'),
  instructions: 'Display extra events from public [JSON](https://fullcalendar.io/docs/events-json-feed) and [iCalendar](https://fullcalendar.io/docs/icalendar) feeds.'|t('app'),
  tip: 'To include the current year in a URL, use `{year}`',
  id: 'extraEventSources',
  name: 'extraEventSources',
  cols: {
    url: {
      type: 'url',
      heading: 'URL'|t('app'),
    },
    format: {
      type: 'select',
      heading: 'Format'|t('app'),
      options: [
        { label: 'JSON', value: 'json' },
        { label: 'iCalendar', value: 'ics' },
      ],
      thin: true,
    },
    color: {
      type: 'color',
      heading: 'Color'|t('app'),
      width: 110,
    }
  },
  allowAdd: true,
  addRowLabel: 'Add an event source'|t('app'),
  allowReorder: true,
  allowDelete: true,
  rows: settings.extraEventSources,
  errors: settings.getErrors('extraEventSources'),
  data: {'error-key': 'extraEventSources'},
  static: readOnly,
}) }}

{% if craft.app.editionHandle != 'solo' %}

  {{ forms.lightswitchField({
    label: 'Organizer Filter'|t('app'),
    instructions: 'Show organizer filter on calendar.',
    name: 'organizerFilterEnabled',
    on: settings.organizerFilterEnabled,
    toggle: 'organizerFilterSettings',
    disabled: readOnly,
  }) }}

  <div id="organizerFilterSettings" class="nested-fields{% if not settings.organizerFilterEnabled %} hidden{% endif %}">

    {{ forms.textField({
      label: 'Organizer Filter Label'|t('app'),
      name: 'organizerFilterLabel',
      value: settings.organizerFilterLabel,
      errors: settings.getErrors('organizerFilterLabel'),
      disabled: readOnly,
    }) }}

    {% set groups = [{ label: "None"|t('app'), value: '' }] %}
    {% for group in craft.app.userGroups.getAllGroups() %}
      {% set groups = groups|merge([{ label: group.name, value: group.handle }]) %}
    {% endfor %}
    {{ forms.textField({
      label: 'Organizer Query Parameter'|t('app'),
      instructions: 'The [parameter](https://craftcms.com/docs/5.x/development/element-queries.html#types-parameters) to use when querying events by organizer ID.',
      name: 'organizerQueryParam',
      value: settings.organizerQueryParam,
      errors: settings.getErrors('organizerQueryParam'),
      class: 'code',
      disabled: readOnly,
    }) }}

    {{ forms.selectField({
      label: 'Organizer User Group'|t('app'),
      instructions: 'User group to query when displaying filter options.',
      name: 'organizerFilterGroup',
      options: groups,
      value: settings.organizerFilterGroup,
      errors: settings.getErrors('organizerFilterGroup'),
      disabled: readOnly,
    }) }}

  </div>

{% endif %}